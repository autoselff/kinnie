str Player {
    var position = [400, 300]
    var color = [255, 120, 0]
    var size = 60
    var speed = 300

    fun draw() {
        drawSquare(position[0], position[1], size, color[0], color[1], color[2])
    }

    fun move() {
        if keyDown("right") {
            position[0] = position[0] + speed * deltaTime
        }
        if keyDown("left") {
            position[0] = position[0] - speed * deltaTime
        }
        if keyDown("up") {
            position[1] = position[1] - speed * deltaTime
        }
        if keyDown("down") {
            position[1] = position[1] + speed * deltaTime
        }
    }
}

str Color {
    var r = 0
    var g = 0
    var b = 0

    fun setColor(rv, gv, bv) {
        r = rv
        g = gv
        b = bv
    }
}

fun main() {
    createWindow(800, 600, "Movement")
    setFont("/usr/share/fonts/Adwaita/AdwaitaMono-Regular.ttf")
    Player player
    player.color = [220, 160, 40]

    Color color
    color.setColor(20, 30, 40)

    var i = 0
    rep 1 {
        clearScreen(color.r, color.g, color.b)
        player.draw()
        player.draw()
        player.move()

        if keyPressed("escape") {
            stop
        }
    }
}
