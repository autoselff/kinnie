str Vec2 {
    var x = 0
    var y = 0

    fun setVec2(xv, yv) {
        x = xv
        y = yv
    }
}

str Color {
    var r = 0
    var g = 0
    var b = 0

    fun setColor(rv, gv, bv) {
        r = rv
        g = gv
        b = bv
    }
}

str Player {
    Vec2 position
    Color color
    var size = 60
    var speed = 300

    fun draw() {
        Vec2 v
        v.x = position.x - size / 2
        v.y = position.y - size / 2
        drawSquare(v.x, v.y, size, color.r, color.g, color.b)
    }

    fun move() {
        if keyDown("right") {
            position.x = position.x + speed * deltaTime
        }
        if keyDown("left") {
            position.x = position.x - speed * deltaTime
        }
        if keyDown("up") {
            position.y = position.y - speed * deltaTime
        }
        if keyDown("down") {
            position.y = position.y + speed * deltaTime
        }
    }
}

fun main() {
    createWindow(800, 600, "Movement")
    setFont("/usr/share/fonts/Adwaita/AdwaitaMono-Regular.ttf")

    Player player
    player.color.setColor(220, 120, 20)
    player.position.setVec2(500, 500)

    Color color
    color.setColor(20, 30, 40)

    Vec2 v

    var i = 0
    rep 1 {
        clearScreen(color.r, color.g, color.b)
        player.draw()
        player.draw()
        player.move()

        if keyPressed("escape") {
            stop
        }

        drawText(20, 20, "Player position: {player.position.x}, {player.position.y}", 20, 255, 255, 255)
    }
}
