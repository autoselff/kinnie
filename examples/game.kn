fun handleInput(t[]) {
    if keyPressed("a") {
        t.add("a")
    }
    if keyPressed("b") {
        t.add("b")
    }
    if keyPressed("c") {
        t.add("c")
    }
    if keyPressed("d") {
        t.add("d")
    }
    if keyPressed("e") {
        t.add("e")
    }
    if keyPressed("f") {
        t.add("f")
    }
    if keyPressed("g") {
        t.add("g")
    }
    if keyPressed("h") {
        t.add("h")
    }
    if keyPressed("i") {
        t.add("i")
    }
    if keyPressed("j") {
        t.add("j")
    }
    if keyPressed("k") {
        t.add("k")
    }
    if keyPressed("l") {
        t.add("l")
    }
    if keyPressed("m") {
        t.add("m")
    }
    if keyPressed("n") {
        t.add("n")
    }
    if keyPressed("o") {
        t.add("o")
    }
    if keyPressed("p") {
        t.add("p")
    }
    if keyPressed("q") {
        t.add("q")
    }
    if keyPressed("r") {
        t.add("r")
    }
    if keyPressed("s") {
        t.add("s")
    }
    if keyPressed("t") {
        t.add("t")
    }
    if keyPressed("u") {
        t.add("u")
    }
    if keyPressed("v") {
        t.add("v")
    }
    if keyPressed("w") {
        t.add("w")
    }
    if keyPressed("x") {
        t.add("x")
    }
    if keyPressed("y") {
        t.add("y")
    }
    if keyPressed("z") {
        t.add("z")
    }
}

str Vec2 {
    var x = 0
    var y = 0

    fun setVec2(xv, yv) {
        x = xv
        y = yv
    }
}

str Color {
    var r = 0
    var g = 0
    var b = 0

    fun setColor(rv, gv, bv) {
        r = rv
        g = gv
        b = bv
    }
}

str Player {
    Vec2 position
    Color color
    var size = 50
    var dir = 0
    var poss = []
    var flashtime = 0

    fun draw(s[], time) {
        var l = len(s)
        var kwstart = l

        if l >= 2 {
            if s[l - 1] == "p" and s[l - 2] == "u" {
                kwstart = l - 2
            }
        }
        if l >= 4 {
            if s[l - 1] == "n" and s[l - 2] == "w" and s[l - 3] == "o" and s[l - 4] == "d" {
                kwstart = l - 4
            }
            if s[l - 1] == "t" and s[l - 2] == "f" and s[l - 3] == "e" and s[l - 4] == "l" {
                kwstart = l - 4
            }
        }
        if l >= 5 {
            if s[l - 1] == "t" and s[l - 2] == "h" and s[l - 3] == "g" and s[l - 4] == "i" and s[l - 5] == "r" {
                kwstart = l - 5
            }
        }

        if l > 0 {
            var i = 0
            rep l {
                if i < len(poss) {
                    var phase = time * 1.5 + i * 0.6
                    var lr = 160 + 80 * sin(phase)
                    var lg = 160 + 80 * sin(phase + 2.1)
                    var lb = 160 + 80 * sin(phase + 4.2)

                    if i >= kwstart {
                        lr = 255
                        lg = 210
                        lb = 40
                    }

                    var wobble = sin(time * 4 + i * 1.2) * 3
                    drawText(poss[i][0], poss[i][1] + wobble, "{s[i]}", 50, lr, lg, lb)
                }
                i = i + 1
            }
        }

        var wobX = sin(time * 5) * 5
        var wobY = cos(time * 4) * 4
        var sz = 56 + sin(time * 2.5) * 5

        var ar = 255
        var ag = 255
        var ab = 255
        if flashtime > 0 {
            ag = 210
            ab = 40
            flashtime = flashtime - deltaTime
            if flashtime < 0 {
                flashtime = 0
            }
        }

        if dir == 0 {
            drawText(position.x + wobX, position.y + wobY, "^", sz, ar, ag, ab)
        }
        else if dir == 1 {
            drawText(position.x + wobX, position.y + wobY, "v", sz, ar, ag, ab)
        }
        else if dir == 2 {
            drawText(position.x + wobX, position.y + wobY, ">", sz, ar, ag, ab)
        }
        else if dir == 3 {
            drawText(position.x + wobX, position.y + wobY, "<", sz, ar, ag, ab)
        }
    }

    fun move(s[]) {
        if keyPressed("backspace") {
            var l = len(poss)
            if l > 0 {
                l = l - 1
                position.x = poss[l][0]
                position.y = poss[l][1]
                var sl = len(s)
                if sl > 0 {
                    s.remove(sl - 1)
                }
                poss.remove(l)
            }
        }
        else if len(s) > len(poss) {
            if dir == 0 {
                poss.add([position.x, position.y])
                position.y = position.y - size
            }
            else if dir == 1 {
                poss.add([position.x, position.y])
                position.y = position.y + size
            }
            else if dir == 2 {
                poss.add([position.x, position.y])
                position.x = position.x + size
            }
            else if dir == 3 {
                poss.add([position.x, position.y])
                position.x = position.x - size
            }
        }
    }
}

fun main() {
    createWindow(1600, 900, "kinnie")
    setFont("/usr/share/fonts/Adwaita/AdwaitaMono-Regular.ttf")

    Player player
    player.color.setColor(220, 120, 20)
    player.position.setVec2(500, 500)
    var segments = []

    var time = 0

    rep true {
        time = time + deltaTime

        var bgr = 15 + 5 * sin(time * 0.4)
        var bgg = 18 + 4 * sin(time * 0.6 + 1.0)
        var bgb = 22 + 7 * sin(time * 0.3 + 2.0)
        clearScreen(bgr, bgg, bgb)

        handleInput(segments)
        player.move(segments)
        player.draw(segments, time)

        var i = 0
        rep len(segments) {
            if segments[i] == "p" and i >= 1 and segments[i - 1] == "u" and player.dir != 0 {
                segments.clear()
                player.poss.clear()
                player.dir = 0
                player.flashtime = 0.3
            }
            else if segments[i] == "n" and i >= 3 and segments[i - 1] == "w" and segments[i - 2] == "o" and segments[i - 3] == "d" and player.dir != 1 {
                segments.clear()
                player.poss.clear()
                player.dir = 1
                player.flashtime = 0.3
            }
            else if segments[i] == "t" and i >= 4 and segments[i - 1] == "h" and segments[i - 2] == "g" and segments[i - 3] == "i" and segments[i - 4] == "r" and player.dir != 2 {
                segments.clear()
                player.poss.clear()
                player.dir = 2
                player.flashtime = 0.3
            }
            else if segments[i] == "t" and i >= 3 and segments[i - 1] == "f" and segments[i - 2] == "e" and segments[i - 3] == "l" and player.dir != 3 {
                segments.clear()
                player.poss.clear()
                player.dir = 3
                player.flashtime = 0.3
            }
            i++
        }

        if keyPressed("escape") {
            stop
        }

        out "{segments}, {player.dir}\n"
    }
}
