fun handleInput(t[]) {
    if keyPressed("a") {
        t.add("a")
    }
    if keyPressed("b") {
        t.add("b")
    }
    if keyPressed("c") {
        t.add("c")
    }
    if keyPressed("d") {
        t.add("d")
    }
    if keyPressed("e") {
        t.add("e")
    }
    if keyPressed("f") {
        t.add("f")
    }
    if keyPressed("g") {
        t.add("g")
    }
    if keyPressed("h") {
        t.add("h")
    }
    if keyPressed("i") {
        t.add("i")
    }
    if keyPressed("j") {
        t.add("j")
    }
    if keyPressed("k") {
        t.add("k")
    }
    if keyPressed("l") {
        t.add("l")
    }
    if keyPressed("m") {
        t.add("m")
    }
    if keyPressed("n") {
        t.add("n")
    }
    if keyPressed("o") {
        t.add("o")
    }
    if keyPressed("p") {
        t.add("p")
    }
    if keyPressed("q") {
        t.add("q")
    }
    if keyPressed("r") {
        t.add("r")
    }
    if keyPressed("s") {
        t.add("s")
    }
    if keyPressed("t") {
        t.add("t")
    }
    if keyPressed("u") {
        t.add("u")
    }
    if keyPressed("v") {
        t.add("v")
    }
    if keyPressed("w") {
        t.add("w")
    }
    if keyPressed("x") {
        t.add("x")
    }
    if keyPressed("y") {
        t.add("y")
    }
    if keyPressed("z") {
        t.add("z")
    }
}

str Vec2 {
    var x = 0
    var y = 0

    fun setVec2(xv, yv) {
        x = xv
        y = yv
    }
}

str Color {
    var r = 0
    var g = 0
    var b = 0

    fun setColor(rv, gv, bv) {
        r = rv
        g = gv
        b = bv
    }
}

str Player {
    Vec2 position
    Color color
    var size = 50
    var dir = 0
    var poss = []

    fun draw(s[]) {
        var l = len(s)
        if l > 0 {
            var i = 0
            rep l {
                if i < len(poss) {
                    drawText(poss[i][0], poss[i][1], "{s[i]}", 50, 255, 255, 255)
                }
                i = i + 1
            }
        }
        if dir == 0 {
            drawText(position.x, position.y, "^", 56, 255, 255, 255)
        }
        else if dir == 1 {
            drawText(position.x, position.y, "v", 56, 255, 255, 255)
        }
        else if dir == 2 {
            drawText(position.x, position.y, ">", 56, 255, 255, 255)
        }
        else if dir == 3 {
            drawText(position.x, position.y, "<", 56, 255, 255, 255)
        }
    }

    fun move(s[]) {
        if keyPressed("backspace") {
            var l = len(poss)
            if l > 0 {
                l = l - 1
                position.x = poss[l][0]
                position.y = poss[l][1]
                var sl = len(s)
                if sl > 0 {
                    s.remove(sl - 1)
                }
                poss.remove(l)
            }
        }
        else {
            if dir == 0 and keyPressed("any") {
                poss.add([position.x, position.y])
                position.y = position.y - size
            }

            if dir == 1 and keyPressed("any") {
                poss.add([position.x, position.y])
                position.y = position.y + size
            }

            if dir == 2 and keyPressed("any") {
                poss.add([position.x, position.y])
                position.x = position.x + size
            }

            if dir == 3 and keyPressed("any") {
                poss.add([position.x, position.y])
                position.x = position.x - size
            }
        }
    }
}

fun main() {
    createWindow(1600, 900, "kinnie")
    setFont("/usr/share/fonts/Adwaita/AdwaitaMono-Regular.ttf")

    Player player
    player.color.setColor(220, 120, 20)
    player.position.setVec2(500, 500)
    var segments = []

    Color color
    color.setColor(20, 20, 20)

    rep true {
        clearScreen(color.r, color.g, color.b)
        player.draw(segments)
        player.move(segments)
        handleInput(segments)

        var i = 0
        rep len(segments) {
            if segments[i] == "p" and i >= 1 and segments[i - 1] == "u" and player.dir != 0 {
                segments.clear()
                player.poss.clear()
                player.dir = 0
            }
            else if segments[i] == "n" and i >= 3 and segments[i - 1] == "w" and segments[i - 2] == "o" and segments[i - 3] == "d" and player.dir != 1 {
                segments.clear()
                player.poss.clear()
                player.dir = 1
            }
            else if segments[i] == "t" and i >= 4 and segments[i - 1] == "h" and segments[i - 2] == "g" and segments[i - 3] == "i" and segments[i - 4] == "r" and player.dir != 2 {
                segments.clear()
                player.poss.clear()
                player.dir = 2
            }
            else if segments[i] == "t" and i >= 3 and segments[i - 1] == "f" and segments[i - 2] == "e" and segments[i - 3] == "l" and player.dir != 3 {
                segments.clear()
                player.poss.clear()
                player.dir = 3
            }
            i++
        }

        if keyPressed("escape") {
            stop
        }

        out "{segments}, {player.dir}\n"
    }
}
