add "lib.kn"

fun movement(player) {
    var speed = 200
    if keyDown("Left") {
        player[0] = player[0] - speed * deltaTime
    }
    if keyDown("Right") {
        player[0] = player[0] + speed * deltaTime
    }
    if keyDown("Up") {
        player[1] = player[1] - speed * deltaTime
    }
    if keyDown("Down") {
        player[1] = player[1] + speed * deltaTime
    }

    if keyPressed("1") {
        stop
    }
}

// main function
fun main() {
    createWindow(800, 600, "kinnietype")
    var player = [400, 300, 60, 50, 100, 200, "player"]
    var object = [600, 200, 30, 50, 200, 100, "object"]

    rep true {
        clearScreen(10, 10, 10)

        movement(player)

        if isColliding(player[0], player[1], object[2], object[0], object[1], object[2]) {
            object[0] = random(100, 700)
            object[1] = random(100, 500)
        }

        drawSquare(player[0], player[1], player[2], player[3], player[4], player[5])
        drawSquare(object[0], object[1], object[2], object[3], object[4], object[5])
    }
}
